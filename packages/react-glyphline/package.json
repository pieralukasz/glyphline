{
	"name": "react-glyphline",
	"version": "0.1.0",
	"description": "React bindings for glyphline: a sentence outline that morphs, a word cursor that glides, drawn selections and marks, over pdf.js pages and HTML text.",
	"keywords": [
		"react",
		"react-component",
		"highlight",
		"text-highlight",
		"pdf",
		"pdfjs",
		"read-aloud",
		"tts",
		"selection",
		"annotation",
		"svg",
		"animation",
		"glyphline"
	],
	"homepage": "https://glyphline.lucaspiera.com/docs/react",
	"bugs": "https://github.com/pieralukasz/glyphline/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pieralukasz/glyphline.git",
		"directory": "packages/react-glyphline"
	},
	"license": "MIT",
	"author": "Łukasz Piera (https://lucaspiera.com)",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"check:package": "publint",
		"prepublishOnly": "bun run typecheck && bun run test && bun run build"
	},
	"dependencies": {
		"glyphline": "workspace:^"
	},
	"peerDependencies": {
		"react": ">=18"
	},
	"devDependencies": {
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"pdfjs-dist": "^6.4.299",
		"react": "^19.3.0",
		"react-dom": "^19"
	}
}
