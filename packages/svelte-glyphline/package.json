{
	"name": "svelte-glyphline",
	"version": "0.1.0",
	"description": "Svelte 5 bindings for glyphline: a sentence outline that morphs, a word cursor that glides, drawn selections and marks, over pdf.js pages and HTML text.",
	"keywords": [
		"svelte",
		"sveltekit",
		"svelte-component",
		"highlight",
		"text-highlight",
		"pdf",
		"pdfjs",
		"read-aloud",
		"tts",
		"selection",
		"annotation",
		"svg",
		"animation",
		"glyphline"
	],
	"homepage": "https://glyphline.lucaspiera.com/docs/svelte",
	"bugs": "https://github.com/pieralukasz/glyphline/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pieralukasz/glyphline.git",
		"directory": "packages/svelte-glyphline"
	},
	"license": "MIT",
	"author": "Łukasz Piera (https://lucaspiera.com)",
	"type": "module",
	"sideEffects": false,
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "svelte-package -i src/lib -o dist",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"test": "vitest run",
		"check:package": "publint",
		"prepublishOnly": "bun run typecheck && bun run test && bun run build"
	},
	"dependencies": {
		"glyphline": "workspace:^"
	},
	"peerDependencies": {
		"svelte": "^5.29.0"
	},
	"devDependencies": {
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"pdfjs-dist": "^6.4.299",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0"
	}
}
