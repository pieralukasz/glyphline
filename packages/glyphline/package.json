{
	"name": "glyphline",
	"version": "0.1.1",
	"description": "Text highlights that sit on the glyphs: a sentence outline that morphs, a word cursor that glides, a drawn selection and marks. For pdf.js pages (positions from the embedded fonts) and HTML. Framework-free core with React (glyphline/react) and Svelte 5 (glyphline/svelte) adapters.",
	"keywords": [
		"highlight",
		"text-highlight",
		"pdf",
		"pdfjs",
		"pdf.js",
		"read-aloud",
		"tts",
		"text-to-speech",
		"karaoke",
		"selection",
		"annotation",
		"svg",
		"animation",
		"react",
		"react-component",
		"svelte",
		"sveltekit"
	],
	"homepage": "https://glyphline.lucaspiera.com",
	"bugs": "https://github.com/pieralukasz/glyphline/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pieralukasz/glyphline.git",
		"directory": "packages/glyphline"
	},
	"license": "MIT",
	"author": "Łukasz Piera (https://lucaspiera.com)",
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./pdf": {
			"types": "./dist/pdf/index.d.ts",
			"default": "./dist/pdf/index.js"
		},
		"./dom": {
			"types": "./dist/dom/index.d.ts",
			"default": "./dist/dom/index.js"
		},
		"./react": {
			"types": "./dist/react/index.d.ts",
			"default": "./dist/react/index.js"
		},
		"./svelte": {
			"types": "./dist/svelte/index.d.ts",
			"svelte": "./dist/svelte/index.js",
			"default": "./dist/svelte/index.js"
		},
		"./style.css": {
			"types": "./dist/css.d.ts",
			"default": "./dist/style.css"
		},
		"./pdf.css": {
			"types": "./dist/css.d.ts",
			"default": "./dist/pdf.css"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"AGENTS.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown && svelte-package -i src/svelte -o dist/svelte && cp src/style.css src/pdf.css src/css.d.ts dist/",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"test": "vitest run",
		"check:package": "publint",
		"prepublishOnly": "bun run typecheck && bun run test && bun run build"
	},
	"peerDependencies": {
		"pdfjs-dist": ">=4",
		"react": ">=18",
		"svelte": "^5.29.0"
	},
	"peerDependenciesMeta": {
		"pdfjs-dist": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"svelte": {
			"optional": true
		}
	},
	"devDependencies": {
		"@sveltejs/package": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"pdfjs-dist": "^6.4.299",
		"react": "^19.3.1",
		"react-dom": "^19",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0"
	}
}
