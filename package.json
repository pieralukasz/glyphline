{
	"name": "glyphline-monorepo",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "bun run --filter glyphline build && bun run --filter react-glyphline --filter svelte-glyphline build",
		"typecheck": "bun run --filter '*' typecheck",
		"test": "bun run --filter '*' test",
		"check:package": "bun run --filter '*' check:package",
		"lint": "biome check ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4",
		"playwright": "^1.60",
		"publint": "^0.3.25",
		"tsdown": "^0.23.0",
		"typescript": "^6",
		"vitest": "^4"
	},
	"packageManager": "bun@1.4.2"
}
